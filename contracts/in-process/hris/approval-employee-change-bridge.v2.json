  "httpProfile": {
    "requiredSingleValueHeaders": {
      "Content-Type": ["application/json", "application/json; charset=utf-8"],
      "X-DWP-Service-Identity": "exact callerWorkloadId",
      "X-DWP-Workload-Proof": "one compact JWS"
