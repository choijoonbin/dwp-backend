      "X-DWP-Display-Name-B64",
      "X-Forwarded-User",
      "X-Forwarded-Email",
      "every unrecognized X-DWP-* header"
    ],
    "pathRules": ["no query", "no fragment", "no trailing slash alias"]
  },
  "workloadProof": {
    "wire": "X-DWP-Workload-Proof compact JWS",
    "joseHeader": {
      "additionalProperties": false,
      "exactFields": ["alg", "typ", "kid"],
      "fixed": {"alg": "RS256", "typ": "JWT"},
      "minimumRsaBits": 2048
    },
    "claims": {
      "additionalProperties": false,
      "exactFields": [
        "iss",
        "aud",
        "sub",
        "iat",
        "nbf",
        "exp",
        "jti",
        "requestNonce",
        "bindingId",
        "purpose",
        "method",
        "path",
        "tenantId",
        "requestBodySha256",
        "authn"
      ],
      "bindings": {
        "iss": "exact callerWorkloadId",
        "sub": "exact callerWorkloadId",
        "aud": "exact ownerWorkloadId",
        "bindingId": "exact SVC bindingId",
        "purpose": "exact binding purpose",
        "method": "POST",
        "path": "exact resolved canonical path",
        "tenantId": "positive signed owner tenant only",
        "requestBodySha256": "lowercase SHA-256 of exact received UTF-8 bytes",
        "authn": ["MTLS_SPIFFE", "CLIENT_CREDENTIAL_JWT"]
      },
      "time": ["iat equals nbf", "exp is after iat", "exp minus iat is at most 30 seconds", "proof is currently valid"],
      "replay": ["jti and requestNonce are distinct canonical lowercase UUIDs", "both share one durable single-use namespace"]
    },
    "derivedAuthentication": {
      "rule": "authn is re-derived from the verified key profile and is never trusted from the claim alone",
      "MTLS_SPIFFE": "certificate SPIFFE workload identity equals sub",
      "CLIENT_CREDENTIAL_JWT": "kid resolves to a registered caller client-key profile"
    },
    "tenantAdmission": [
      "tenantId comes only from the verified signed claim",
      "owner revalidates the caller current tenant grant",
      "owner revalidates target tenant equality",
      "caller tenant override is forbidden"
    ]
  },
  "commandDigest": {
    "bodySha256": "sha256(exact received UTF-8 request bytes)",
    "canonicalMaterial": "HRIS-BRIDGE-V2\\n{bindingId}\\n{method}\\n{exactPath}\\n{callerWorkloadId}\\n{audience}\\n{tenantId}\\n{purpose}\\napplication/json\\n{bodySha256}",
    "encoding": "UTF-8 with LF separators only",
    "result": "lowercase SHA-256",
    "excluded": ["proof", "kid", "jti", "requestNonce", "iat", "nbf", "exp", "traceparent", "tracestate"],
    "retry": "persist exact request bytes and commandDigest; mint a new workload proof for each attempt"
  },
  "createAndSubmitAuthority": {
    "requesterRefPattern": "^person:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "requesterResolution": "service-native Auth lookup returns exactly one ACTIVE same-tenant user/person",
    "forbiddenRequesterSources": ["browser headers", "ThreadLocal actor", "synthetic user"],
    "workflowResolution": [
      "workflowKey and workflowVersion resolve exactly one PUBLISHED effective typed-quorum workflow version",
      "the pinned workflow version resolves exactly one active effective PUBLISHED form binding",
      "generic current_version fallback is forbidden"
    ],
    "nativePayload": {
      "additionalProperties": false,
      "fields": ["requestId", "subjectRef", "subjectRevision", "requesterRef", "requestedAction", "payloadRef", "payloadDigest", "requestedAt", "correlationId"],
      "fixedOutsidePayload": {"state": "PENDING", "priority": "NORMAL"},
      "title": "Employee change request {requestId}",
      "summary": "Requested action {requestedAction} for {subjectRef}",
      "ledgerOnly": ["idempotencyKey"]
    }
  },
  "idempotency": {
    "createAndSubmit": {
      "primarySemanticIdentity": ["tenantId", "subjectRef", "subjectRevision"],
      "collisionAliases": [["tenantId", "requestId"], ["tenantId", "idempotencyKey"]],
      "sameCommandDigest": "return exact persisted original response bytes",
      "differentCommandDigestForAnyMatchingIdentity": "HTTP_409",
      "splitAliasOwnership": "HTTP_409"
    },
    "decisionCallback": {
      "identity": ["tenantId", "decisionEventId"],
      "pathRequestPublicIdIncludedBy": "commandDigest exactPath",
      "sameCommandDigest": "return exact persisted original CommandReceiptV1 bytes",
      "differentCommandDigest": "HTTP_409"
    }
  },
  "decisionSource": {
    "approvalPolicyRevision": "apr_quorum_stage_runtime.context.pins.policyVersion frozen at typed-quorum submission",
    "decisionActorPublicId": "actor of the accepted vote that caused the terminal decision",
    "correlationId": "original PDX-010 correlationId",
    "payloadDigest": "original PDX-010 payloadDigest",
    "forbidden": ["current policy requery", "request revision substitution", "delivery-attempt actor or revision"]
  },
  "commandReceiptV1": {
    "additionalProperties": false,
    "requiredFields": [
      "receiptId",
      "commandType",
      "originatingAction",
      "subjectPrincipalPublicId",
      "populationScopeDigest",
      "fieldPolicyRevision",
      "purposeCode",
