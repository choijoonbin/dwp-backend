    "NonNegativeCount": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "Locale": {"type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"},
    "ScopeType": {"type": "string", "enum": ["GLOBAL", "TENANT", "LEGAL_ENTITY", "ORGANIZATION", "POPULATION", "SUBJECT"]},
