{
  "components": {
    "schemas": {
      "AccessMode": {
        "enum": [
          "NORMAL",
          "ELEVATED",
          "PROVIDER_SUPPORT"
        ],
        "type": "string"
      },
      "AccessSource": {
        "enum": [
          "ENTITLEMENT",
          "RELATIONSHIP",
          "MANAGEMENT",
          "SUPPORT"
        ],
        "type": "string"
      },
      "ApiErrorResponse": {
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "errorCode",
          "message"
        ],
        "type": "object"
      },
      "ApiResponseContextListData": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ContextListData"
          },
          "success": {
            "const": true,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "data"
        ],
        "type": "object"
      },
      "ApiResponseGovernedEvaluationData": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GovernedEvaluationData"
          },
          "success": {
            "const": true,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "data"
        ],
        "type": "object"
      },
      "ApiResponseProductEvaluationData": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProductEvaluationData"
          },
          "success": {
            "const": true,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "data"
        ],
        "type": "object"
      },
      "AuthorityStatus": {
        "enum": [
          "NOT_EVALUATED",
          "AVAILABLE",
          "UNAVAILABLE"
        ],
        "type": "string"
      },
      "CapabilityAuthorityMode": {
        "enum": [
          "PERMISSION",
          "PERMISSION_AND_RELATIONSHIP",
          "PERMISSION_OR_RELATIONSHIP"
        ],
        "type": "string"
      },
      "CapabilityGrant": {
        "properties": {
          "activationState": {
            "type": "string"
          },
          "authorityMode": {
            "$ref": "#/components/schemas/CapabilityAuthorityMode"
          },
          "capabilityContractKey": {
            "type": "string"
          },
          "grantKind": {
            "const": "CAPABILITY",
            "type": "string"
          },
          "predicatePolicyKeys": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "readOnly": {
            "type": "boolean"
          },
          "requiresProductEntitlement": {
            "type": "boolean"
          },
          "resolvedCapabilityCode": {
            "type": "string"
          },
          "responsibility": {
            "$ref": "#/components/schemas/Responsibility"
          },
          "responsibilityRequirement": {
            "type": "string"
          },
          "scopeKeys": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "validUntil": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "grantKind",
          "capabilityContractKey",
          "authorityMode",
          "predicatePolicyKeys",
          "scopeKeys",
          "requiresProductEntitlement",
          "readOnly"
        ],
        "type": "object"
      },
      "ContextListData": {
        "properties": {
          "activeAccessMode": {
            "$ref": "#/components/schemas/AccessMode"
          },
          "contexts": {
            "items": {
              "$ref": "#/components/schemas/EffectiveContext"
            },
            "type": "array"
          },
          "contractVersion": {
            "type": "string"
          },
          "decisionRevision": {
            "type": "string"
          },
          "generatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "rollouts": {
            "items": {
              "$ref": "#/components/schemas/ProductRollout"
            },
            "type": "array"
          },
          "sourceRevisions": {
            "$ref": "#/components/schemas/SourceRevisions"
          }
        },
        "required": [
          "contractVersion",
          "decisionRevision",
          "sourceRevisions",
          "activeAccessMode",
          "generatedAt",
          "contexts",
          "rollouts"
        ],
        "type": "object"
      },
      "Decision": {
        "enum": [
          "ALLOWED",
          "APP_DENIED",
          "SURFACE_DENIED",
          "ROUTE_DENIED",
          "SCOPE_SELECTION_REQUIRED",
          "SCOPE_INVALID",
          "EXPIRED",
          "ACTIVATION_REQUIRED",
          "STEP_UP_REQUIRED",
          "SOD_CONFLICT",
          "SUPPORT_SCOPE_DENIED",
          "AUTHORITY_UNAVAILABLE"
        ],
        "type": "string"
      },
      "EffectiveContext": {
        "properties": {
          "accessMode": {
            "$ref": "#/components/schemas/AccessMode"
          },
          "accessSource": {
            "$ref": "#/components/schemas/AccessSource"
          },
          "appResourceKey": {
            "type": "string"
          },
          "contextKey": {
            "type": "string"
          },
          "effectiveGrants": {
            "items": {
              "$ref": "#/components/schemas/EffectiveGrant"
            },
            "type": "array"
          },
          "plane": {
            "enum": [
              "work",
              "management"
            ],
            "type": "string"
          },
          "productKey": {
            "type": "string"
          },
          "revalidateAt": {
            "format": "date-time",
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/EffectiveScope"
            },
            "type": "array"
          },
          "surfaceKey": {
            "type": "string"
          }
        },
        "required": [
          "contextKey",
          "productKey",
          "surfaceKey",
          "plane",
          "accessMode",
          "accessSource",
          "effectiveGrants",
          "scopes",
          "revalidateAt"
        ],
        "type": "object"
      },
      "EffectiveGrant": {
        "discriminator": {
          "mapping": {
            "CAPABILITY": "#/components/schemas/CapabilityGrant",
            "POLICY": "#/components/schemas/PolicyGrant"
          },
          "propertyName": "grantKind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/CapabilityGrant"
          },
          {
            "$ref": "#/components/schemas/PolicyGrant"
          }
        ]
      },
      "EffectiveScope": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "readOnly": {
            "type": "boolean"
          },
          "validUntil": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "key",
          "kind",
          "displayName",
          "isDefault",
          "readOnly"
        ],
        "type": "object"
      },
      "GovernedDecision": {
        "enum": [
          "ALLOWED",
          "ROUTE_DENIED",
          "EXPIRED",
          "STEP_UP_REQUIRED",
          "SOD_CONFLICT",
          "AUTHORITY_UNAVAILABLE"
        ],
        "type": "string"
      },
      "GovernedEvaluationData": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/GovernedRouteAccessContext"
          },
          "decision": {
            "$ref": "#/components/schemas/GovernedDecision"
          },
          "decisionRevision": {
            "type": "string"
          },
          "expiredAt": {
            "format": "date-time",
            "type": "string"
          },
          "reasonCode": {
            "type": "string"
          },
          "requestPolicyRef": {
            "type": "string"
          },
          "requiredAssurance": {
            "type": "string"
          },
          "validUntil": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "decisionRevision"
        ],
        "type": "object"
      },
      "GovernedEvaluationRequest": {
        "additionalProperties": false,
        "properties": {
          "contextKey": {
            "type": "string"
          },
          "navigationContextId": {
            "minLength": 1,
            "type": "string"
          },
          "routeContractKey": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "$ref": "#/components/schemas/GovernedSubject"
          },
          "target": {
            "$ref": "#/components/schemas/GovernedTarget"
          }
        },
        "required": [
          "subject",
          "navigationContextId",
          "routeContractKey"
        ],
        "type": "object"
      },
      "GovernedRouteAccessContext": {
        "properties": {
          "accessMode": {
            "$ref": "#/components/schemas/AccessMode"
          },
          "accessSource": {
            "$ref": "#/components/schemas/AccessSource"
          },
          "contextKey": {
            "type": "string"
          },
          "decisionRevision": {
            "type": "string"
          },
          "effectiveReadOnly": {
            "type": "boolean"
          },
          "navigationContextId": {
            "type": "string"
          },
          "revalidateAt": {
            "format": "date-time",
            "type": "string"
          },
          "routeGrantRef": {
            "type": "string"
          }
        },
        "required": [
          "contextKey",
          "navigationContextId",
          "accessSource",
          "accessMode",
          "routeGrantRef",
          "effectiveReadOnly",
          "decisionRevision",
          "revalidateAt"
        ],
        "type": "object"
      },
      "GovernedSubject": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "GOVERNED_CONTEXT",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "GovernedTarget": {
        "additionalProperties": false,
        "properties": {
          "expectedObjectVersion": {
            "type": "string"
          },
          "opaqueTargetRef": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PolicyAuthorityMode": {
        "enum": [
          "ENTITLEMENT",
          "RELATIONSHIP",
          "ENTITLEMENT_AND_RELATIONSHIP",
          "SUPPORT_SESSION"
        ],
        "type": "string"
      },
      "PolicyGrant": {
        "properties": {
          "accessPolicyKey": {
            "type": "string"
          },
          "authorityMode": {
            "$ref": "#/components/schemas/PolicyAuthorityMode"
          },
          "grantKind": {
            "const": "POLICY",
            "type": "string"
          },
          "policyDecisionRef": {
            "type": "string"
          },
          "readOnly": {
            "type": "boolean"
          },
          "requiresProductEntitlement": {
            "type": "boolean"
          },
          "scopeKeys": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "validUntil": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "grantKind",
          "accessPolicyKey",
          "authorityMode",
          "scopeKeys",
          "requiresProductEntitlement",
          "readOnly"
        ],
        "type": "object"
      },
      "ProductEvaluationData": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/EffectiveContext"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "decisionRevision": {
            "type": "string"
          },
          "effectiveReadOnly": {
            "type": "boolean"
          },
          "expiredAt": {
            "format": "date-time",
            "type": "string"
          },
          "reasonCode": {
            "type": "string"
          },
          "requestPolicyRef": {
            "type": "string"
          },
          "requiredAssurance": {
            "type": "string"
          },
          "revalidateAt": {
            "format": "date-time",
            "type": "string"
          },
          "routeGrantRef": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/EffectiveScope"
          },
          "validUntil": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "decisionRevision"
        ],
        "type": "object"
      },
      "ProductEvaluationRequest": {
        "additionalProperties": false,
        "properties": {
          "contextKey": {
            "type": "string"
          },
          "contextScopeKey": {
            "type": "string"
          },
          "routeContractKey": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "$ref": "#/components/schemas/ProductSubject"
          }
        },
        "required": [
          "subject",
          "routeContractKey"
        ],
        "type": "object"
      },
      "ProductRollout": {
        "properties": {
          "authorityStatus": {
            "$ref": "#/components/schemas/AuthorityStatus"
          },
          "cohort": {
            "type": "string"
          },
          "flags": {
            "$ref": "#/components/schemas/RolloutFlags"
          },
          "opaqueRevision": {
            "type": "string"
          },
          "productKey": {
            "type": "string"
          },
          "state": {
            "enum": [
              "000",
              "100",
              "110",
              "111"
            ],
            "type": "string"
          }
        },
        "required": [
          "productKey",
          "state",
          "flags",
          "cohort",
          "opaqueRevision",
          "authorityStatus"
        ],
        "type": "object"
      },
      "ProductSubject": {
        "additionalProperties": false,
        "properties": {
          "productKey": {
            "minLength": 1,
            "type": "string"
          },
          "surfaceKey": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "const": "PRODUCT",
            "type": "string"
          }
        },
        "required": [
          "type",
          "productKey",
          "surfaceKey"
        ],
        "type": "object"
      },
      "Responsibility": {
        "properties": {
          "code": {
            "type": "string"
          },
          "resourceSetKey": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "resourceSetKey"
        ],
        "type": "object"
      },
      "RolloutFlags": {
        "properties": {
          "capabilityEnforcement": {
            "type": "boolean"
          },
          "contextShadow": {
            "type": "boolean"
          },
          "surfaceUi": {
            "type": "boolean"
          }
        },
        "required": [
          "contextShadow",
          "capabilityEnforcement",
          "surfaceUi"
        ],
        "type": "object"
      },
      "SourceRevisions": {
        "properties": {
          "auth": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "productRelationship": {
            "type": "string"
          },
          "support": {
            "type": "string"
          },
          "targetPopulation": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Subject": {
        "properties": {
          "productKey": {
            "type": "string"
          },
          "surfaceKey": {
            "type": "string"
          },
          "type": {
            "enum": [
              "PRODUCT",
              "GOVERNED_CONTEXT"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Gateway-owned Product Surface context and evaluation endpoints.",
    "title": "DWP Gateway-owned API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/governed-route-access/evaluate": {
      "post": {
        "operationId": "gatewayGovernedRouteAccessEvaluate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GovernedEvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGovernedEvaluationData"
                }
              }
            },
            "description": "Evaluated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authentication required"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authority unavailable"
          }
        },
        "tags": [
          "gateway"
        ]
      }
    },
    "/api/auth/product-surface-access/evaluate": {
      "post": {
        "operationId": "gatewayProductSurfaceAccessEvaluate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductEvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseProductEvaluationData"
                }
              }
            },
            "description": "Evaluated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authentication required"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authority unavailable"
          }
        },
        "tags": [
          "gateway"
        ]
      }
    },
    "/api/auth/product-surface-contexts": {
      "get": {
        "operationId": "gatewayProductSurfaceContexts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseContextListData"
                }
              }
            },
            "description": "Resolved contexts"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authentication required"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authority unavailable"
          }
        },
        "tags": [
          "gateway"
        ]
      }
    }
  }
}
