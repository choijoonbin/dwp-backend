            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeasurementFreshness": {
        "enum": [
          "CURRENT",
          "STALE",
          "UNAVAILABLE"
        ],
        "title": "MeasurementFreshness",
        "type": "string"
      },
      "ModelRoutePolicy": {
        "additionalProperties": false,
        "properties": {
          "availabilityObservedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Availabilityobservedat"
          },
          "availabilityState": {
            "$ref": "#/components/schemas/ExternalDataState",
            "default": "UNVERIFIED"
          },
          "model": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "maxLength": 40,
            "minLength": 2,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "title": "Provider",
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "ModelRoutePolicy",
        "type": "object"
      },
      "RuntimeControlState": {
        "enum": [
          "ENABLED",
          "EMERGENCY_DISABLED",
          "POLICY_NOT_CONFIGURED",
          "CONTROL_UNAVAILABLE"
        ],
        "title": "RuntimeControlState",
        "type": "string"
      },
      "SetAIEmergencyDisableRequest": {
        "additionalProperties": false,
        "properties": {
          "changeReason": {
            "maxLength": 500,
            "minLength": 10,
            "title": "Changereason",
            "type": "string"
          },
          "disabled": {
            "title": "Disabled",
            "type": "boolean"
          },
          "expectedVersion": {
            "minimum": 1.0,
            "title": "Expectedversion",
            "type": "integer"
          }
        },
        "required": [
          "disabled",
          "expectedVersion",
          "changeReason"
        ],
        "title": "SetAIEmergencyDisableRequest",
        "type": "object"
      },
      "TenantAIExecutionPolicy": {
