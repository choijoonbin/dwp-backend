          },
          "allowedModelRoutes": {
            "items": {
              "$ref": "#/components/schemas/ModelRoutePolicy"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Allowedmodelroutes",
            "type": "array"
          },
          "allowedToolKeys": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Allowedtoolkeys",
            "type": "array"
          },
          "budgetEnforcementMode": {
            "$ref": "#/components/schemas/BudgetEnforcementMode"
          },
          "emergencyDisabled": {
            "title": "Emergencydisabled",
            "type": "boolean"
          },
          "evaluationEvidenceState": {
            "$ref": "#/components/schemas/EvaluationEvidenceState",
            "default": "UNAVAILABLE"
          },
          "evaluationGateStatus": {
            "$ref": "#/components/schemas/EvaluationGateStatus"
          },
          "evaluationObservedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluationobservedat"
          },
          "evaluationPolicyVersion": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluationpolicyversion"
          },
          "maxOutputTokensPerRequest": {
            "maximum": 4096.0,
            "minimum": 128.0,
            "title": "Maxoutputtokensperrequest",
            "type": "integer"
          },
          "periodTokenLimit": {
            "anyOf": [
              {
                "maximum": 10000000000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Periodtokenlimit"
          },
          "policyVersion": {
            "minimum": 1.0,
            "title": "Policyversion",
            "type": "integer"
          },
          "requireEvaluationPass": {
            "title": "Requireevaluationpass",
            "type": "boolean"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "emergencyDisabled",
          "allowedModelRoutes",
          "maxOutputTokensPerRequest",
          "budgetEnforcementMode",
          "alertThresholdPercent",
          "requireEvaluationPass",
          "evaluationGateStatus",
          "policyVersion",
          "updatedAt"
        ],
        "title": "TenantAIExecutionPolicy",
        "type": "object"
      },
      "ToolEnforcementState": {
        "enum": [
          "NOT_CONNECTED"
        ],
        "title": "ToolEnforcementState",
        "type": "string"
      },
      "UpdateAIExecutionPolicyRequest": {
        "additionalProperties": false,
        "properties": {
          "alertThresholdPercent": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Alertthresholdpercent",
            "type": "integer"
          },
          "allowedKnowledgeSources": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Allowedknowledgesources",
            "type": "array"
          },
          "allowedModelRoutes": {
            "items": {
              "$ref": "#/components/schemas/ModelRoutePolicy"
            },
            "maxItems": 50,
