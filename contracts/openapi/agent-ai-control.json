  "info": {
    "title": "DWP Agent Runtime",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/ai-control": {
      "get": {
        "operationId": "get_ai_control_overview_v1_admin_ai_control_get",
        "parameters": [
          {
            "in": "header",
            "name": "X-DWP-Tenant-ID",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Dwp-Tenant-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-DWP-Permissions",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Dwp-Permissions"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIControlOverviewEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ai Control Overview",
        "tags": [
          "administration"
        ]
      }
    },
    "/v1/admin/ai-control/bootstrap": {
      "post": {
        "operationId": "bootstrap_ai_control_v1_admin_ai_control_bootstrap_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-DWP-Tenant-ID",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Dwp-Tenant-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-DWP-User-ID",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Dwp-User-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Correlation-ID",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Correlation-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-DWP-Permissions",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Dwp-Permissions"
            }
          },
          {
            "description": "Required for product-authorization rollout states 110/111. The gateway rejects a missing or stale value before the state-changing request reaches the Agent owner service; rollout states 000/100 ignore it.",
            "in": "header",
            "name": "X-DWP-Expected-Decision-Revision",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Dwp-Expected-Decision-Revision"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapAIExecutionPolicyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIControlOverviewEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bootstrap Ai Control",
        "tags": [
          "administration"
        ]
      }
    },
