{
  "components": {
    "schemas": {
      "AIControlOverview": {
        "additionalProperties": false,
        "properties": {
          "controlScope": {
            "const": "ASK_RUNTIME",
            "default": "ASK_RUNTIME",
            "title": "Controlscope",
            "type": "string"
          },
          "enforcementActivationState": {
            "$ref": "#/components/schemas/EnforcementActivationState"
          },
          "policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TenantAIExecutionPolicy"
              },
              {
                "type": "null"
              }
            ]
          },
          "runtimeControlState": {
            "$ref": "#/components/schemas/RuntimeControlState"
          },
          "toolEnforcementState": {
            "$ref": "#/components/schemas/ToolEnforcementState",
            "default": "NOT_CONNECTED"
          },
          "usage": {
            "$ref": "#/components/schemas/AIUsageObservation"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "enforcementActivationState",
          "runtimeControlState",
          "usage"
        ],
        "title": "AIControlOverview",
        "type": "object"
      },
      "AIControlOverviewEnvelope": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AIControlOverview"
          },
          "message": {
            "default": "DWAI-ON AI runtime control loaded.",
            "title": "Message",
            "type": "string"
          },
          "status": {
            "default": "SUCCESS",
            "title": "Status",
            "type": "string"
          },
          "success": {
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "AIControlOverviewEnvelope",
        "type": "object"
      },
      "AIUsageObservation": {
        "additionalProperties": false,
        "properties": {
          "billedCostMinor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Billedcostminor"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "estimatedCostMinor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimatedcostminor"
          },
          "measuredInputTokens": {
            "minimum": 0.0,
            "title": "Measuredinputtokens",
            "type": "integer"
          },
          "measuredOutputTokens": {
            "minimum": 0.0,
            "title": "Measuredoutputtokens",
            "type": "integer"
          },
          "measuredTotalTokens": {
            "minimum": 0.0,
            "title": "Measuredtotaltokens",
            "type": "integer"
          },
          "measurementFreshness": {
            "$ref": "#/components/schemas/MeasurementFreshness"
          },
          "measurementObservedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurementobservedat"
          },
          "periodEnd": {
            "format": "date-time",
            "title": "Periodend",
            "type": "string"
          },
          "periodStart": {
            "format": "date-time",
            "title": "Periodstart",
            "type": "string"
          },
          "providerBillingState": {
            "$ref": "#/components/schemas/ExternalDataState",
            "default": "UNAVAILABLE"
          },
          "providerPricingState": {
            "$ref": "#/components/schemas/ExternalDataState",
            "default": "UNAVAILABLE"
          },
          "providerUsageState": {
            "$ref": "#/components/schemas/ExternalDataState",
            "default": "UNAVAILABLE"
          },
          "reservedTokens": {
            "minimum": 0.0,
            "title": "Reservedtokens",
            "type": "integer"
          },
          "unmeasuredReservedTokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Unmeasuredreservedtokens",
            "type": "integer"
          }
        },
        "required": [
          "periodStart",
          "periodEnd",
          "measuredInputTokens",
          "measuredOutputTokens",
          "measuredTotalTokens",
          "reservedTokens",
          "measurementFreshness"
        ],
        "title": "AIUsageObservation",
        "type": "object"
      },
      "BootstrapAIExecutionPolicyRequest": {
        "additionalProperties": false,
        "properties": {
          "alertThresholdPercent": {
            "default": 80,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Alertthresholdpercent",
            "type": "integer"
          },
          "allowedKnowledgeSources": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Allowedknowledgesources",
            "type": "array"
          },
          "allowedModelRoutes": {
            "items": {
              "$ref": "#/components/schemas/ModelRoutePolicy"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Allowedmodelroutes",
            "type": "array"
          },
          "allowedToolKeys": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Allowedtoolkeys",
            "type": "array"
          },
          "budgetEnforcementMode": {
            "$ref": "#/components/schemas/BudgetEnforcementMode",
            "default": "ALERT_ONLY"
          },
          "changeReason": {
            "maxLength": 500,
            "minLength": 10,
            "title": "Changereason",
            "type": "string"
          },
          "evaluationGateStatus": {
            "$ref": "#/components/schemas/EvaluationGateStatus",
            "default": "NOT_REQUIRED"
          },
          "evaluationObservedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluationobservedat"
          },
          "evaluationPolicyVersion": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluationpolicyversion"
          },
          "expectedExistingCount": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Expectedexistingcount",
            "type": "integer"
          },
          "idempotencyKey": {
            "format": "uuid",
            "title": "Idempotencykey",
            "type": "string"
          },
          "maxOutputTokensPerRequest": {
            "default": 900,
            "maximum": 4096.0,
            "minimum": 128.0,
            "title": "Maxoutputtokensperrequest",
            "type": "integer"
          },
          "periodTokenLimit": {
            "anyOf": [
              {
                "maximum": 10000000000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Periodtokenlimit"
          },
          "requireEvaluationPass": {
            "default": false,
            "title": "Requireevaluationpass",
            "type": "boolean"
          }
        },
        "required": [
          "idempotencyKey",
          "expectedExistingCount",
          "allowedModelRoutes",
          "changeReason"
        ],
        "title": "BootstrapAIExecutionPolicyRequest",
        "type": "object"
      },
      "BudgetEnforcementMode": {
        "enum": [
          "ALERT_ONLY",
          "ENFORCED"
        ],
        "title": "BudgetEnforcementMode",
        "type": "string"
      },
      "EnforcementActivationState": {
        "enum": [
          "DISABLED",
          "ENABLED"
        ],
        "title": "EnforcementActivationState",
        "type": "string"
      },
      "EvaluationEvidenceState": {
        "enum": [
          "VERIFIED",
          "STALE",
          "UNAVAILABLE"
        ],
        "title": "EvaluationEvidenceState",
        "type": "string"
      },
      "EvaluationGateStatus": {
        "enum": [
          "NOT_REQUIRED",
          "PENDING",
          "PASSED",
          "FAILED",
          "STALE"
        ],
        "title": "EvaluationGateStatus",
        "type": "string"
      },
      "ExternalDataState": {
        "enum": [
          "VERIFIED",
          "STALE",
          "UNAVAILABLE",
          "UNVERIFIED"
        ],
        "title": "ExternalDataState",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
