    "openRecord": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "keyedArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openRecord"
      }
    },
    "stepUpVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "issuer",
        "audienceByOwnerService",
        "requiredAcr",
        "publicKeyPem"
      ],
      "properties": {
        "algorithm": {
          "const": "RS256"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "audienceByOwnerService": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval",
            "people"
          ],
          "properties": {
            "approval": {
              "const": "dwp-approval-server"
            },
            "people": {
              "const": "dwp-people-server"
            }
          }
        },
        "requiredAcr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "publicKeyPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----"
        }
      }
    },
    "stepUpChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "challengeId",
        "policy",
        "capabilityContractKey",
        "decisionRevision",
        "scopeRef",
        "targetType",
        "targetId",
        "targetVersion",
        "method",
        "path",
        "actorUserId",
        "tenantId",
        "idempotencyKey",
        "payload",
        "issuedAt",
        "authenticatedAt",
        "expiresAt",
        "nonce",
        "state"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^STEPUP_[A-Z0-9_]+$"
        },
        "challengeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "policy": {
          "type": "string",
          "pattern": "^STEPUP-MGMT-(HIGH|CRITICAL)-V1$"
        },
        "ownerServiceKey": {
          "enum": [
            "approval",
            "people"
          ]
        },
        "commandContractKey": {
          "type": "string",
          "pattern": "^route\\."
        },
        "stepUpCommandBindingKey": {
          "type": "string",
          "pattern": "^route\\..+\\.binding\\.[0-9]+$"
        },
        "contextKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "capabilityContractKey": {
          "type": "string",
          "minLength": 1
        },
        "decisionRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scopeRef": {
          "type": "string",
          "minLength": 1
        },
        "targetType": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "targetVersion": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "enum": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/api/"
        },
        "actorUserId": {
          "type": "integer",
          "minimum": 1
        },
        "tenantId": {
          "type": "integer",
          "minimum": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "payload": {
          "type": "object"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "authenticatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state": {
          "enum": [
            "ACTIVE",
            "CONSUMED"
          ]
        },
        "algorithm": {
          "const": "RS256"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "acr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "amr": {
          "type": "array",
          "const": [
            "mfa"
          ]
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetIdSource": {
          "enum": [
            "PATH_PARAMETER",
            "COMMAND_BODY"
          ]
        },
        "targetIdPathParameter": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "targetIdBodyFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        },
        "expectedObjectVersionSource": {
          "enum": [
            "COMMAND_BODY",
            "COMMAND_HEADER"
          ]
        },
        "expectedObjectVersionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "requiredRegistryRef": {
          "$ref": "#/$defs/registryReference"
        },
        "compactToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "requiredRegistryRef",
              "ownerServiceKey"
            ],
            "properties": {
              "ownerServiceKey": {
                "const": "approval"
              }
            }
          },
          "then": {
            "properties": {
              "requiredRegistryRef": {
                "$ref": "#/$defs/registryRefV2"
              },
              "audience": {
                "const": "dwp-approval-server"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "requiredRegistryRef",
              "ownerServiceKey"
            ],
            "properties": {
              "ownerServiceKey": {
                "const": "people"
              }
            }
          },
          "then": {
            "properties": {
              "requiredRegistryRef": {
                "$ref": "#/$defs/registryRefV3"
              },
              "audience": {
                "const": "dwp-people-server"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "ownerServiceKey"
            ]
          },
          "then": {
            "required": [
              "commandContractKey",
              "stepUpCommandBindingKey",
              "contextKey",
              "algorithm",
              "keyId",
              "issuer",
              "audience",
              "acr",
              "amr",
              "payloadSha256",
              "commandSha256",
              "targetIdSource",
              "expectedObjectVersionSource",
              "expectedObjectVersionName",
              "requiredRegistryRef",
              "compactToken"
            ]
          }
        },
        {
          "if": {
            "required": [
              "targetIdSource"
            ],
            "properties": {
              "targetIdSource": {
                "const": "PATH_PARAMETER"
              }
            }
          },
          "then": {
            "required": [
              "targetIdPathParameter"
            ],
            "not": {
              "required": [
                "targetIdBodyFields"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "targetIdSource"
            ],
            "properties": {
              "targetIdSource": {
                "const": "COMMAND_BODY"
              }
            }
          },
          "then": {
            "required": [
              "targetIdBodyFields"
            ],
            "not": {
              "required": [
                "targetIdPathParameter"
              ]
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "kind": {
          "enum": [
            "ENTITLEMENT",
            "CAPABILITY",
            "POLICY",
            "RELATIONSHIP",
            "SUPPORT",
            "COMPOSITE"
          ]
        },
        "appEntitlements": {
          "$ref": "#/$defs/stringArray"
        },
        "capabilityContractKeys": {
          "$ref": "#/$defs/stringArray"
        },
        "accessPolicyKeys": {
          "$ref": "#/$defs/stringArray"
        },
        "scopeRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "relationshipRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "supportSessionRef": {
          "type": "string"
        },
        "responsibility": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "responsibilityRequirement": {
          "enum": [
            "REQUIRED",
            "NOT_REQUIRED"
          ]
        },
        "authorityMode": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "NORMAL",
            "PROVIDER_SUPPORT"
          ]
        },
        "readOnly": {
          "type": "boolean"
        },
        "validUntil": {
          "type": "string"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "explicitDenies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "fixtureId",
        "group",
        "composition",
        "expected"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^PS-(G|C|A|H)[0-9]{3}$"
        },
        "fixtureId": {
          "type": "string",
          "pattern": "^FX-[A-Z0-9-]+$"
        },
        "group": {
          "enum": [
            "GUARD",
            "CANARY",
            "APPROVALS",
            "HCM"
          ]
        },
        "composition": {
          "$ref": "#/$defs/stringArray"
        },
