{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/contracts/product-authorization/pilot-fixtures.v1.schema.json",
  "title": "DWP Product Surface Pilot Authorization Fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureBundleKey",
    "fixedClock",
    "stepUpVerification",
    "catalogs",
    "components",
    "testCases",
    "negativeCases",
    "contextCases",
    "riskPolicies",
    "reservedContracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fixtureBundleKey": {
      "const": "pilot-fixtures.v1"
    },
    "fixedClock": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "normalValidUntil": {
      "type": "string",
      "format": "date-time"
    },
    "stepUpVerification": {
      "$ref": "#/$defs/stepUpVerification"
    },
    "fixtureChecksumAlgorithm": {
      "const": "SHA-256"
    },
    "fixtureChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registryLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "bundleKey",
        "indexSha256",
        "latestAliasVersion",
        "versions"
      ],
      "properties": {
        "authority": {
          "const": "INFORMATIONAL_ONLY"
        },
        "bundleKey": {
          "const": "product-surfaces"
        },
        "indexSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "latestAliasVersion": {
          "const": 34
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registryReference"
          },
          "uniqueItems": true,
          "minItems": 34,
          "maxItems": 34
        }
      }
    },
    "sourceRevisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes",
        "targetPopulations",
        "objects",
        "payloads",
        "relationships",
        "supportSessions",
        "stepUpChallenges"
      ],
      "properties": {
        "scopes": {
          "$ref": "#/$defs/keyedArray"
        },
        "targetPopulations": {
          "$ref": "#/$defs/keyedArray"
        },
        "objects": {
          "$ref": "#/$defs/keyedArray"
        },
        "payloads": {
          "$ref": "#/$defs/keyedArray"
        },
        "relationships": {
          "$ref": "#/$defs/keyedArray"
        },
        "supportSessions": {
          "$ref": "#/$defs/keyedArray"
        },
        "stepUpChallenges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stepUpChallenge"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 71,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    },
    "negativeCases": {
      "type": "array",
      "minItems": 46,
      "items": {
        "$ref": "#/$defs/negativeCase"
      }
    },
    "contextCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/contextCase"
      }
    },
    "riskPolicies": {
      "$ref": "#/$defs/keyedArray"
    },
    "reservedContracts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
