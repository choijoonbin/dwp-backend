{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/contracts/product-authorization/pilot-test-registry-overrides.v1.schema.json",
  "title": "DWP Product Surface Contract-test Registry Overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "integrity", "overrides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "contract-test" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "overrides": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "routeContractKey", "testIds", "descriptor"],
        "properties": {
          "key": {
            "enum": ["test.management-and-app.v1", "test.services-catalog-jit.v1"]
          },
          "routeContractKey": { "type": "string", "pattern": "^route\\.test\\." },
          "testIds": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["PS-G006", "PS-G010"] }
          },
          "descriptor": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
